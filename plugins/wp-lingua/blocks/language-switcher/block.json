{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lingua/language-switcher",
	"version": "0.5.0",
	"title": "Language Switcher",
	"category": "widgets",
	"icon": "translation",
	"description": "Displays a language switcher for multilingual content.",
	"keywords": [ "language", "translation", "multilingual", "switcher", "lingua" ],
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	},
	"attributes": {
		"style": {
			"type": "string",
			"default": "dropdown"
		}
	},
	"textdomain": "wp-lingua",
	"editorScript": "file:./editor.js",
	"render": "file:./render.php"
}
